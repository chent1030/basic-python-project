# =============================================================================
# 生产环境变量示例 —— 复制为 .env 后填入真实值
# (.env 已被 .gitignore 忽略,不会提交)
#
# 部署方式:服务器上从源码构建镜像(docker build)再运行。
# 构建时拉基础镜像 + Python 包走 JFrog 代理(公司内网),所以需要 JFrog 登录。
# =============================================================================

# ---- JFrog 镜像仓库登录(deploy.sh 构建前用来 login,让 build 能拉基础镜像)----
# REGISTRY 只填地址(域名/IP),不带协议
REGISTRY=your-jfrog.company.com
REGISTRY_USER=your-username
REGISTRY_PASSWORD=your-password-or-token

# ---- 构建参数(传给 docker build,让基础镜像 + Python 包走 JFrog)----
# 基础镜像:JFrog 里 python 镜像的完整地址(build 时作为 FROM 的基础镜像)
PYTHON_BASE_IMAGE=your-jfrog.company.com/docker-proxy/python:3.11-slim
# uv 安装脚本:JFrog/内网里的地址(默认从 astral.sh 拉,内网拉不到时填这个)
UV_INSTALLER_URL=https://your-jfrog.company.com/files/uv/install.sh
# 私有 PyPI 源(JFrog 的 PyPI 仓库),build 时 uv 从这里装 Python 依赖
UV_INDEX_URL=https://your-jfrog.company.com/api/pypi/pypi-proxy/simple
# 私有 PyPI 认证(无认证留空)
UV_INDEX_USER=
UV_INDEX_PASSWORD=

# ---- 数据库密码(与 config/local.yaml 里的 enc: 解密后一致)----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_DB=app

REDIS_PASSWORD=CHANGE_ME_redis_password

# ---- 部署选项 ----
# 构建出的本地镜像名(本地镜像,不推 JFrog)
APP_IMAGE=fastapi-demo:latest
# 部署后是否自动清理悬空镜像(yes/no)
PRUNE_IMAGES=yes
APP_PORT=18555

# ---- MySQL(若启用,在 docker-compose.prod.yml 取消 mysql 段注释)----
# MYSQL_ROOT_PASSWORD=CHANGE_ME
# MYSQL_DATABASE=business
