# =============================================================================
# 生产环境变量示例 —— 复制为 .env 后填入真实值
# (.env 已被 .gitignore 忽略,不会提交)
#
# docker compose -f docker-compose.prod.yml 会自动读取同目录的 .env
# =============================================================================

# ---- 镜像地址(公司 Harbor)----
IMAGE_NAME=harbor.example.com/your-group/fastapi-demo
IMAGE_TAG=latest

# 如果公司镜像源里也有 postgres/redis 镜像,在这里指定(避免从 Docker Hub 拉)
# PYTHON_BASE_IMAGE=harbor.example.com/library/python:3.11-slim
# POSTGRES_IMAGE=harbor.example.com/library/postgres:16-alpine
# REDIS_IMAGE=harbor.example.com/library/redis:7-alpine

# ---- 服务端口 ----
APP_PORT=8000

# ---- 数据库密码(建议与 config/local.yaml 里的 enc: 解密后一致)----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_DB=app

REDIS_PASSWORD=CHANGE_ME_redis_password

# ---- MySQL(若启用)----
# MYSQL_ROOT_PASSWORD=CHANGE_ME
# MYSQL_DATABASE=business
