# =============================================================================
# 生产环境变量示例 —— 复制为 .env 后填入真实值
# (.env 已被 .gitignore 忽略,不会提交)
#
# deploy.sh 和 docker compose -f docker-compose.prod.yml 都读取本文件。
# =============================================================================

# ---- JFrog 镜像仓库登录(deploy.sh 用)----
# REGISTRY 只填仓库地址(域名/IP),不带协议、不带路径
REGISTRY=your-jfrog.company.com
REGISTRY_USER=your-username
REGISTRY_PASSWORD=your-password-or-token

# ---- 镜像地址(完整路径,含仓库路径不含 tag)----
# JFrog 里通常是 <jfrog域名>/<仓库名>/<镜像名>,例如:
#   your-jfrog.company.com/docker-local/fastapi-demo
IMAGE_NAME=your-jfrog.company.com/docker-local/fastapi-demo
IMAGE_TAG=latest              # 或具体版本号 v1.0.0 / commit sha

# 如果 JFrog 里也有 postgres/redis 基础镜像,在这里指定(避免从 Docker Hub 拉)
# 不填则默认从 Docker Hub 拉 postgres:16-alpine / redis:7-alpine
# POSTGRES_IMAGE=your-jfrog.company.com/docker-proxy/postgres:16-alpine
# REDIS_IMAGE=your-jfrog.company.com/docker-proxy/redis:7-alpine

# ---- 服务端口 ----
APP_PORT=8000

# ---- 数据库密码(建议与 config/local.yaml 里的 enc: 解密后一致)----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_DB=app

REDIS_PASSWORD=CHANGE_ME_redis_password

# ---- 部署选项 ----
# 部署后是否自动清理悬空镜像(yes/no),省磁盘
PRUNE_IMAGES=yes

# ---- MySQL(若启用,在 docker-compose.prod.yml 取消 mysql 段注释)----
# MYSQL_ROOT_PASSWORD=CHANGE_ME
# MYSQL_DATABASE=business
